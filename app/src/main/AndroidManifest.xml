<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Permissions are declared by the phase that needs them, not up front:
        Phase 3 routines  — location, exact alarms, boot completed, notifications
        Phase 5 SOS       — SMS, foreground service
      Declaring them early would show users grants the app cannot yet justify.
    -->

    <!--
      Microphone capture. Phase 2 voice: the user speaks and Lumi listens, push-to-talk only,
      never an always-on wake word (decisions.md). Requested at runtime on first use; a denied
      grant falls back to typed input rather than erroring.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Reminders (Phase 3): a reminder that cannot reach the user never happened.
      POST_NOTIFICATIONS is requested at runtime from the reminders screen; a denied grant
      degrades to an audit entry that says so rather than a silent miss.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Exact alarms ring at the minute the user named, including through Doze. Both forms are
      declared because both exist: SCHEDULE_EXACT_ALARM governs API 31-32 (granted by default),
      USE_EXACT_ALARM governs 33+ where this app's core reminder function qualifies for the
      automatic grant. When neither holds, arming falls back to an inexact alarm and the
      periodic sweep bounds the delay — delivery degrades, it does not stop.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!--
      Alarms die with a shutdown. The boot receiver re-arms every pending reminder after
      restart, so "remind me tomorrow" survives the phone being off overnight.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      The one network permission, and the only thing that uses it is the first-run model download.
      Every feature works with the network disabled (decisions.md), and the single deliberate
      exception — opt-in web search — is session-only and off by default.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".LumiApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lumi">

        <!--
          The GPU backend loads these through dlopen at runtime. Without the declarations the
          loader refuses them on API 31+ and LiteRT-LM silently falls back to CPU, which is the
          difference between a usable demo and an unusable one.

          required="false" on both: a device without OpenCL must still install and run on CPU.
        -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-car.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-pixel.so" android:required="false" />


        <!-- The mascot app icon is Dev B's Phase 1 task; the platform default applies until then. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Lumi"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Reminder delivery (Phase 3). Not exported: the fire action arrives from Lumi's own
          PendingIntent, and BOOT_COMPLETED is a protected broadcast only the system may send,
          so nothing third-party can reach this receiver either way.
        -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          The home-screen widget (Phase 3). Exported because launchers bind and update widgets
          through this receiver; its only behaviour is re-rendering Lumi's own stored reminders.
        -->
        <receiver
            android:name=".ui.widget.LumiWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lumi_widget_info" />
        </receiver>
    </application>

</manifest>
